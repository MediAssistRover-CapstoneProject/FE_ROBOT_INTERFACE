# Private Node process only. Never use EXPO_PUBLIC_ for these values.
MAR_BACKEND_URL=https://mediassistrover.duckdns.org
MAR_DELIVERY_HOST=127.0.0.1
MAR_DELIVERY_PORT=8790
MAR_DELIVERY_PAIRING_KEY=
MAR_ROBOT_ID=
MAR_ROBOT_CODE=
MAR_DEVICE_SECRET=
# Use a viewer account allowed to read the robot's delivery jobs.
MAR_VIEWER_USERNAME=
MAR_VIEWER_PASSWORD=
# Alternative to username/password: an existing short-lived account access token.
MAR_VIEWER_ACCESS_TOKEN=
MAR_DELIVERY_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082
# For a tablet over LAN, prefer TLS and use a certificate trusted by that tablet.
MAR_DELIVERY_TLS_CERT=
MAR_DELIVERY_TLS_KEY=
# Development on a trusted LAN only, explicit opt-in when TLS is unavailable.
MAR_DELIVERY_ALLOW_LAN_HTTP=false
